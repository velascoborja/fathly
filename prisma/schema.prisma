generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  SCENARIO
}

enum Frequency {
  MONTHLY
  ANNUAL
}

enum CommitmentType {
  BILL
  SAVINGS
}

enum FinancialItemStatus {
  ACTIVE
  PAUSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("es")
  accounts      Account[]
  sessions      Session[]
  memberships   HouseholdMember[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Household {
  id          String            @id @default(cuid())
  name        String
  members     HouseholdMember[]
  budgetPlans BudgetPlan[]
  deposits    Deposit[]
  commitments Commitment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model BudgetPlan {
  id                            String       @id @default(cuid())
  householdId                   String
  name                          String
  status                        PlanStatus   @default(ACTIVE)
  lowMonthlyMarginBasisPoints   Int          @default(500)
  onboardingCompletedAt         DateTime?
  startsOn                      DateTime?
  endsOn                        DateTime?
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt
  household                     Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  deposits                      Deposit[]
  commitments                   Commitment[]

  @@index([householdId, status])
}

model Deposit {
  id          String              @id @default(cuid())
  householdId String
  planId      String
  name        String
  amountCents Int
  status      FinancialItemStatus @default(ACTIVE)
  notes       String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plan        BudgetPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([householdId, planId, status])
}

model Commitment {
  id          String              @id @default(cuid())
  householdId String
  planId      String
  name        String
  category    String
  icon        String              @default("receipt")
  type        CommitmentType      @default(BILL)
  frequency   Frequency           @default(MONTHLY)
  amountCents Int
  status      FinancialItemStatus @default(ACTIVE)
  notes       String?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  plan        BudgetPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([householdId, planId, status])
  @@index([category])
}
